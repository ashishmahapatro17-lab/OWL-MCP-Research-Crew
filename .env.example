# Optional LLM configuration. Without OPENAI_API_KEY, the project uses its deterministic fallback.\n# Copy this file to .env and add your own key locally. Never commit .env.\nOPENAI_API_KEY=\nLLM_MODEL=gpt-4o-mini\n# Optional: use an OpenAI-compatible provider endpoint.\n# LLM_BASE_URL=https://your-provider.example/v1\n